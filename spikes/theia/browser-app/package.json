{
  "name": "@dev.fast/whiteboard-theia-browser",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "theia build --mode production",
    "build:dev": "theia build --mode development",
    "start": "theia start --hostname ${WHITEBOARD_HOST:-127.0.0.1} --port ${PORT:-3000}"
  },
  "dependencies": {
    "@dev.fast/whiteboard-theia": "0.0.0",
    "@theia/collaboration": "1.75.0",
    "@theia/core": "1.75.0",
    "@theia/editor": "1.75.0",
    "@theia/filesystem": "1.75.0",
    "@theia/markers": "1.75.0",
    "@theia/messages": "1.75.0",
    "@theia/monaco": "1.75.0",
    "@theia/navigator": "1.75.0",
    "@theia/preferences": "1.75.0",
    "@theia/process": "1.75.0",
    "@theia/workspace": "1.75.0"
  },
  "devDependencies": {
    "@theia/cli": "1.75.0"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Whiteboard (Theia spike)",
        "defaultTheme": {
          "light": "light",
          "dark": "dark"
        },
        "preferences": {
          "security.workspace.trust.enabled": true
        }
      }
    }
  }
}
